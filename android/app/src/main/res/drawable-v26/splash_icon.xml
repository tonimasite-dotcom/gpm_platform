<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon used only for the Android 12+ system splash screen (values-v31/styles.xml).
     Declaring it as adaptive makes Android respect the foreground's safe zone instead of
     auto-cropping a flat icon into its splash circle, which is what cut off the helmet/fist
     before. The white background matches the logo badge used on the login screen. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground android:drawable="@mipmap/splash_icon_foreground" />
</adaptive-icon>
